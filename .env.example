# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=your_jwt_secret_here

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Supabase PostgreSQL (Phase 9) — session pooler (IPv4-compatible)
DATABASE_URL=postgresql://user:password@host:port/database

# Integration test schema (same Supabase project, fitness_test schema — per D-01)
DATABASE_URL_TEST=postgresql://user:password@host:port/database?options=-c%20search_path%3Dfitness_test

# OpenRouter LLM Integration (Phase 15)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

## Primary model for weekly plan generation:
LLM_MODEL=openrouter/owl-alpha
