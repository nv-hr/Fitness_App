# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=your_jwt_secret_here

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Supabase PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database

# Integration test schema (same Supabase project, fitness_test schema)
DATABASE_URL_TEST=postgresql://user:password@host:5432/database?options=-c%20search_path%3Dfitness_test

# Smoke test (Docker)
# SMOKE_IMAGE_TAG=fitness-app:smoke-test
# SKIP_DOCKER_BUILD=false
# SMOKE_PORT=0

# OpenRouter LLM Integration (Phase 15)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
## Recommended fallback model (if primary is unavailable):
# LLM_FALLBACK_MODEL=gpt-4o-mini
